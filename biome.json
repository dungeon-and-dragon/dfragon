{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/dist-ssr",
      "!**/out",
      "!**/.test-dist",
      "!**/coverage",
      "!packages/licenses/notices",
      "!packages/models/score-engine",
      "!apps/storybook/public/mockServiceWorker.js",
      "!apps/web/src/app/routeTree.gen.ts",
      "!**/package-lock.json",
      "!**/*.svg"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "includes": ["**"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "html": {
    "formatter": {
      "enabled": true,
      "selfCloseVoidElements": "always"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "enabled": false
  },
  "plugins": ["./scripts/biome/return-expression.grit"],
  "linter": {
    "rules": {
      "preset": "none",
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noExtraBooleanCast": "error",
        "noUselessCatch": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessRename": "error",
        "noUselessThisAlias": "error",
        "noVoid": "error"
      },
      "correctness": {
        "noChildrenProp": "error",
        "noConstAssign": "error",
        "noConstantCondition": "error",
        "noConstantMathMinMaxClamp": "error",
        "noEmptyCharacterClassInRegex": "error",
        "noEmptyPattern": "error",
        "noGlobalObjectCalls": "error",
        "noInvalidBuiltinInstantiation": "error",
        "noInvalidConstructorSuper": "error",
        "noNonoctalDecimalEscape": "error",
        "noPrecisionLoss": "error",
        "noRenderReturnValue": "error",
        "noSelfAssign": "error",
        "noSetterReturn": "error",
        "noSwitchDeclarations": "error",
        "noUndeclaredVariables": "error",
        "noUnreachable": "error",
        "noUnreachableSuper": "error",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedImports": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "noVoidElementsWithChildren": "error",
        "useIsNan": "error",
        "useJsxKeyInIterable": "error",
        "useValidForDirection": "error",
        "useValidTypeof": "error",
        "useYield": "error"
      },
      "nursery": {
        "useStringStartsEndsWith": "error"
      },
      "security": {
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error"
      },
      "style": {
        "noNestedTernary": "error",
        "useBlockStatements": "error"
      },
      "suspicious": {
        "noAssignInExpressions": "error",
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noClassAssign": "error",
        "noCompareNegZero": "error",
        "noConstantBinaryExpressions": "error",
        "noControlCharactersInRegex": "error",
        "noDebugger": "error",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateElseIf": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noDuplicatedSpreadProps": "error",
        "noEmptySource": "error",
        "noFallthroughSwitchClause": "error",
        "noFunctionAssign": "error",
        "noGlobalAssign": "error",
        "noImportAssign": "error",
        "noIrregularWhitespace": "error",
        "noMisleadingCharacterClass": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noPrototypeBuiltins": "error",
        "noReactStringRefs": "error",
        "noRedeclare": "error",
        "noShadowRestrictedNames": "error",
        "noSparseArray": "error",
        "noThenProperty": "error",
        "noUnassignedVariables": "error",
        "noUnsafeNegation": "error",
        "noUnusedExpressions": "error",
        "noUselessEscapeInString": "error",
        "noUselessRegexBackrefs": "error",
        "noWith": "error",
        "useGetterReturn": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.fixture.*",
        "!**/test/**",
        "!**/tests/**",
        "!**/__tests__/**",
        "!**/fixture/**",
        "!**/fixtures/**",
        "!**/testing/**",
        "!**/test-support/**",
        "!packages/ui/scripts/test-consumer-resolution.mjs",
        "!**/generated/**",
        "!**/vendor/**",
        "!**/*.generated.*"
      ],
      "plugins": [
        "./scripts/biome/regex-literal-constant.grit",
        "./scripts/biome/let-branch-assignment.grit",
        "./scripts/biome/hidden-screen-prop.grit",
        "./scripts/biome/jsx-prop-callback.grit",
        "./scripts/biome/absent-first-conditional.grit"
      ]
    },
    {
      "includes": ["**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noArguments": "error"
          },
          "correctness": {
            "noUndeclaredVariables": "off"
          },
          "style": {
            "useConst": "error",
            "useSpreadOverApply": "error"
          },
          "suspicious": {
            "noVar": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.ts",
        "**/*.mts",
        "**/*.cts",
        "**/*.tsx",
        "apps/api/**",
        "apps/ops/**",
        "apps/worker/**",
        "apps/web/**",
        "apps/internal/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noBannedTypes": "error",
            "noUselessTypeConstraint": "error"
          },
          "style": {
            "noCommonJs": "error",
            "noNamespace": "error",
            "useArrayLiterals": "error",
            "useAsConstAssertion": "error"
          },
          "suspicious": {
            "noDuplicateEnumValues": "error",
            "noEmptyInterface": "error",
            "noExplicitAny": "error",
            "noExtraNonNullAssertion": "error",
            "noMisleadingInstantiator": "error",
            "noNonNullAssertedOptionalChain": "error",
            "noTsIgnore": "error",
            "noUnsafeDeclarationMerging": "error",
            "useNamespaceKeyword": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/web/**", "apps/internal/**"],
      "linter": {
        "rules": {
          "security": {
            "noBlankTarget": "error"
          },
          "suspicious": {
            "noCommentText": "error",
            "noUnknownAttribute": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/**/*.ts",
        "apps/web/**/*.tsx",
        "apps/internal/**/*.ts",
        "apps/internal/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": {
              "level": "warn",
              "options": {
                "reportUnnecessaryDependencies": false
              }
            },
            "useHookAtTopLevel": "error"
          },
          "nursery": {
            "useReactCompiler": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/**/*.ts",
        "apps/web/**/*.tsx",
        "apps/internal/**/*.ts",
        "apps/internal/**/*.tsx",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.cy.*",
        "!**/*.stories.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": {
              "level": "error",
              "options": {
                "allowConstantExport": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/internal/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../*", "../**"],
                    "message": "상위 폴더 상대 경로 대신 #ops-<폴더>/... 또는 #ops-app/... alias로 가져온다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../*", "../**"],
                    "message": "상위 폴더 상대 경로 대신 #<폴더>/... alias로 가져온다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/capture-search/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "src/features/capture-search/lib는 화면과 무관한 로직이라 React를 import하지 않는다. 화면 코드는 apps/web/src의 UI 폴더에 둔다.",
                  "react-dom": "src/features/capture-search/lib는 화면과 무관한 로직이라 React를 import하지 않는다. 화면 코드는 apps/web/src의 UI 폴더에 둔다.",
                  "@dfragon/ui": "src/features/capture-search/lib는 화면과 무관한 로직이라 @dfragon/ui를 import하지 않는다. 화면 코드는 apps/web/src의 UI 폴더에 둔다."
                },
                "patterns": [
                  {
                    "group": ["../*", "../**"],
                    "message": "상위 폴더 상대 경로 대신 #<폴더>/... alias로 가져온다."
                  },
                  {
                    "group": [
                      "#pages/**",
                      "#app/**",
                      "#widgets/**",
                      "#features/**",
                      "!#features/capture-search/lib/**",
                      "!#features/capture-search/api/**",
                      "!#features/capture-search/model/client-host",
                      "!#features/capture-search/model/install-browser-host",
                      "#shared/ui/**",
                      "**/hooks/**",
                      "**/components/**",
                      "**/pages/**",
                      "**/site/**",
                      "**/sections/**",
                      "**/animations/**",
                      "**/styles/**",
                      "**/fixture/**"
                    ],
                    "message": "src/features/capture-search/lib는 UI 폴더를 import하지 않는다. 화면 코드는 apps/web/src의 UI 폴더에 둔다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/**", "apps/ops/src/**", "apps/worker/src/**"],
      "linter": {
        "rules": {
          "style": {
            "useNodejsImportProtocol": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/api/**", "apps/worker/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@dfragon/api",
                      "@dfragon/api/**",
                      "@dfragon/worker",
                      "@dfragon/worker/**",
                      "**/apps/api/**",
                      "**/apps/worker/**",
                      "../**/api/**",
                      "../**/worker/**"
                    ],
                    "message": "API와 worker는 서로의 코드를 import하지 않는다. 함께 쓰는 코드는 @dfragon/server-core에 둔다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/**", "apps/ops/src/**", "apps/worker/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@dfragon/api",
                      "@dfragon/api/**",
                      "@dfragon/worker",
                      "@dfragon/worker/**",
                      "**/apps/api/**",
                      "**/apps/worker/**",
                      "../**/api/**",
                      "../**/worker/**"
                    ],
                    "message": "API와 worker는 서로의 코드를 import하지 않는다. 함께 쓰는 코드는 @dfragon/server-core에 둔다."
                  },
                  {
                    "group": ["../*", "../**", "!../**/api/**", "!../**/worker/**"],
                    "message": "자기 폴더 밖의 파일은 상대 경로 대신 #<계층>/... alias로 가져온다. 같은 폴더의 파일만 ./로 가져온다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/domain/**", "apps/ops/src/domain/**", "apps/worker/src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "useNodejsImportProtocol": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@dfragon/api",
                      "@dfragon/api/**",
                      "@dfragon/worker",
                      "@dfragon/worker/**",
                      "**/apps/api/**",
                      "**/apps/worker/**",
                      "../**/api/**",
                      "../**/worker/**"
                    ],
                    "message": "API와 worker는 서로의 코드를 import하지 않는다. 함께 쓰는 코드는 @dfragon/server-core에 둔다."
                  },
                  {
                    "group": [
                      "**/application/**",
                      "**/infrastructure/**",
                      "**/presentation/**",
                      "**/runtime/**",
                      "#application/**",
                      "#infrastructure/**",
                      "#presentation/**",
                      "#runtime/**"
                    ],
                    "message": "domain은 다른 계층을 import하지 않는다. service와 port는 application/<기능>/, Neople과 DB 연결은 infrastructure/, route는 presentation/에 두고, 그쪽에서 domain을 가져다 쓴다."
                  },
                  {
                    "group": ["hono", "hono/**", "@hono/**"],
                    "message": "domain은 Hono를 쓰지 않는다. route는 presentation/http/, route를 app에 붙이는 코드는 runtime/routes/에 둔다."
                  },
                  {
                    "group": ["node:*", "node:*/**"],
                    "message": "domain은 Node.js 내장 module을 쓰지 않는다. 파일, 네트워크, 프로세스를 쓰는 코드는 infrastructure/에 두고, application/<기능>/ports.ts의 함수 타입으로 받는다."
                  },
                  {
                    "group": ["../*", "../**", "!../**/api/**", "!../**/worker/**"],
                    "message": "자기 폴더 밖의 파일은 상대 경로 대신 #<계층>/... alias로 가져온다. 같은 폴더의 파일만 ./로 가져온다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/api/src/application/**",
        "apps/ops/src/application/**",
        "apps/worker/src/application/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNodejsImportProtocol": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@dfragon/api",
                      "@dfragon/api/**",
                      "@dfragon/worker",
                      "@dfragon/worker/**",
                      "**/apps/api/**",
                      "**/apps/worker/**",
                      "../**/api/**",
                      "../**/worker/**"
                    ],
                    "message": "API와 worker는 서로의 코드를 import하지 않는다. 함께 쓰는 코드는 @dfragon/server-core에 둔다."
                  },
                  {
                    "group": [
                      "**/infrastructure/**",
                      "**/presentation/**",
                      "**/runtime/**",
                      "#infrastructure/**",
                      "#presentation/**",
                      "#runtime/**"
                    ],
                    "message": "application은 infrastructure, presentation, runtime을 import하지 않는다. 외부 호출은 application/<기능>/ports.ts에 함수 타입으로 적고 구현은 infrastructure/에, 연결은 runtime/에 둔다."
                  },
                  {
                    "group": ["hono", "hono/**", "@hono/**"],
                    "message": "application은 Hono를 쓰지 않는다. route는 presentation/http/, route를 app에 붙이는 코드는 runtime/routes/에 둔다."
                  },
                  {
                    "group": [
                      "node:fs",
                      "node:fs/**",
                      "node:net",
                      "node:http",
                      "node:https",
                      "node:http2",
                      "node:tls",
                      "node:dgram",
                      "node:dns",
                      "node:dns/**",
                      "node:child_process",
                      "node:worker_threads",
                      "ky",
                      "koffi"
                    ],
                    "message": "application은 파일, 네트워크, native library를 직접 쓰지 않는다. application/<기능>/ports.ts에 함수 타입을 두고 구현은 infrastructure/에 둔다."
                  },
                  {
                    "group": ["../*", "../**", "!../**/api/**", "!../**/worker/**"],
                    "message": "자기 폴더 밖의 파일은 상대 경로 대신 #<계층>/... alias로 가져온다. 같은 폴더의 파일만 ./로 가져온다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/api/src/infrastructure/**",
        "apps/ops/src/infrastructure/**",
        "apps/worker/src/infrastructure/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNodejsImportProtocol": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@dfragon/api",
                      "@dfragon/api/**",
                      "@dfragon/worker",
                      "@dfragon/worker/**",
                      "**/apps/api/**",
                      "**/apps/worker/**",
                      "../**/api/**",
                      "../**/worker/**"
                    ],
                    "message": "API와 worker는 서로의 코드를 import하지 않는다. 함께 쓰는 코드는 @dfragon/server-core에 둔다."
                  },
                  {
                    "group": [
                      "**/presentation/**",
                      "**/runtime/**",
                      "#presentation/**",
                      "#runtime/**"
                    ],
                    "message": "infrastructure는 presentation, runtime을 import하지 않는다. HTTP 응답으로 바꾸는 코드는 presentation/http/, service에 넘기는 연결은 runtime/에 둔다."
                  },
                  {
                    "group": ["../*", "../**", "!../**/api/**", "!../**/worker/**"],
                    "message": "자기 폴더 밖의 파일은 상대 경로 대신 #<계층>/... alias로 가져온다. 같은 폴더의 파일만 ./로 가져온다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/presentation/**", "apps/ops/src/presentation/**"],
      "linter": {
        "rules": {
          "style": {
            "useNodejsImportProtocol": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@dfragon/api",
                      "@dfragon/api/**",
                      "@dfragon/worker",
                      "@dfragon/worker/**",
                      "**/apps/api/**",
                      "**/apps/worker/**",
                      "../**/api/**",
                      "../**/worker/**"
                    ],
                    "message": "API와 worker는 서로의 코드를 import하지 않는다. 함께 쓰는 코드는 @dfragon/server-core에 둔다."
                  },
                  {
                    "group": [
                      "**/infrastructure/**",
                      "**/runtime/**",
                      "#infrastructure/**",
                      "#runtime/**"
                    ],
                    "message": "presentation은 infrastructure, runtime을 import하지 않는다. Neople과 DB 호출은 application의 service를 거치고, service와 adapter 연결은 runtime/에 둔다."
                  },
                  {
                    "group": ["**/application/**/repository.js", "#application/**/repository.js"],
                    "message": "presentation은 Repository를 import type으로도 가져오지 않는다. Controller는 application/<기능>/service.ts의 Service만 받고, Repository는 runtime/이 Service에 넣는다."
                  },
                  {
                    "group": ["**/application/**/ports.js", "#application/**/ports.js"],
                    "message": "presentation은 port를 import type으로도 가져오지 않는다. Controller는 application/<기능>/service.ts의 Service만 받고, Neople 호출, queue 같은 port는 runtime/이 Service에 넣는다."
                  },
                  {
                    "group": ["../*", "../**", "!../**/api/**", "!../**/worker/**"],
                    "message": "자기 폴더 밖의 파일은 상대 경로 대신 #<계층>/... alias로 가져온다. 같은 폴더의 파일만 ./로 가져온다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/http-server/**"],
      "linter": {
        "rules": {
          "style": {
            "useNodejsImportProtocol": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@dfragon/api",
                      "@dfragon/api/**",
                      "@dfragon/database",
                      "@dfragon/database/**",
                      "@dfragon/neople",
                      "@dfragon/neople/**",
                      "**/apps/**"
                    ],
                    "message": "공용 HTTP package는 앱과 DB, Neople 코드를 import하지 않는다. 앱마다 다른 실패 표와 route는 각 앱에 두고 createHonoApp의 option으로 넘긴다."
                  }
                ]
              }

{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/dist-ssr",
      "!**/dist-examples",
      "!**/out",
      "!**/.test-dist",
      "!**/coverage",
      "!packages/licenses/notices",
      "!packages/models/score-engine",
      "!**/package-lock.json",
      "!**/*.svg"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "includes": ["**"]
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "html": {
    "formatter": {
      "enabled": true,
      "selfCloseVoidElements": "always"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "enabled": false
  },
  "plugins": ["./scripts/biome/return-expression.grit"],
  "linter": {
    "rules": {
      "preset": "none",
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noExtraBooleanCast": "error",
        "noUselessCatch": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessRename": "error",
        "noUselessThisAlias": "error",
        "noVoid": "error"
      },
      "correctness": {
        "noChildrenProp": "error",
        "noConstAssign": "error",
        "noConstantCondition": "error",
        "noConstantMathMinMaxClamp": "error",
        "noEmptyCharacterClassInRegex": "error",
        "noEmptyPattern": "error",
        "noGlobalObjectCalls": "error",
        "noInvalidBuiltinInstantiation": "error",
        "noInvalidConstructorSuper": "error",
        "noNonoctalDecimalEscape": "error",
        "noPrecisionLoss": "error",
        "noRenderReturnValue": "error",
        "noSelfAssign": "error",
        "noSetterReturn": "error",
        "noSwitchDeclarations": "error",
        "noUndeclaredVariables": "error",
        "noUnreachable": "error",
        "noUnreachableSuper": "error",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedImports": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "noVoidElementsWithChildren": "error",
        "useIsNan": "error",
        "useJsxKeyInIterable": "error",
        "useValidForDirection": "error",
        "useValidTypeof": "error",
        "useYield": "error"
      },
      "nursery": {
        "useStringStartsEndsWith": "error"
      },
      "security": {
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error"
      },
      "style": {
        "noNestedTernary": "error",
        "useBlockStatements": "error"
      },
      "suspicious": {
        "noAssignInExpressions": "error",
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noClassAssign": "error",
        "noCompareNegZero": "error",
        "noConstantBinaryExpressions": "error",
        "noControlCharactersInRegex": "error",
        "noDebugger": "error",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateElseIf": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noDuplicatedSpreadProps": "error",
        "noEmptySource": "error",
        "noFallthroughSwitchClause": "error",
        "noFunctionAssign": "error",
        "noGlobalAssign": "error",
        "noImportAssign": "error",
        "noIrregularWhitespace": "error",
        "noMisleadingCharacterClass": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noPrototypeBuiltins": "error",
        "noReactStringRefs": "error",
        "noRedeclare": "error",
        "noShadowRestrictedNames": "error",
        "noSparseArray": "error",
        "noThenProperty": "error",
        "noUnassignedVariables": "error",
        "noUnsafeNegation": "error",
        "noUnusedExpressions": "error",
        "noUselessEscapeInString": "error",
        "noUselessRegexBackrefs": "error",
        "noWith": "error",
        "useGetterReturn": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.fixture.*",
        "!**/test/**",
        "!**/tests/**",
        "!**/__tests__/**",
        "!**/fixture/**",
        "!**/fixtures/**",
        "!**/testing/**",
        "!**/test-support/**",
        "!packages/ui/scripts/test-consumer-resolution.mjs",
        "!**/generated/**",
        "!**/vendor/**",
        "!**/*.generated.*"
      ],
      "plugins": [
        "./scripts/biome/regex-literal-constant.grit",
        "./scripts/biome/let-branch-assignment.grit",
        "./scripts/biome/hidden-screen-prop.grit",
        "./scripts/biome/jsx-prop-callback.grit",
        "./scripts/biome/absent-first-conditional.grit"
      ]
    },
    {
      "includes": ["**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noArguments": "error"
          },
          "correctness": {
            "noUndeclaredVariables": "off"
          },
          "style": {
            "useConst": "error",
            "useSpreadOverApply": "error"
          },
          "suspicious": {
            "noVar": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.ts",
        "**/*.mts",
        "**/*.cts",
        "**/*.tsx",
        "apps/api/**",
        "apps/web/**",
        "apps/internal/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noBannedTypes": "error",
            "noUselessTypeConstraint": "error"
          },
          "style": {
            "noCommonJs": "error",
            "noNamespace": "error",
            "useArrayLiterals": "error",
            "useAsConstAssertion": "error"
          },
          "suspicious": {
            "noDuplicateEnumValues": "error",
            "noEmptyInterface": "error",
            "noExplicitAny": "error",
            "noExtraNonNullAssertion": "error",
            "noMisleadingInstantiator": "error",
            "noNonNullAssertedOptionalChain": "error",
            "noTsIgnore": "error",
            "noUnsafeDeclarationMerging": "error",
            "useNamespaceKeyword": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/web/**", "apps/internal/**"],
      "linter": {
        "rules": {
          "security": {
            "noBlankTarget": "error"
          },
          "suspicious": {
            "noCommentText": "error",
            "noUnknownAttribute": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/**/*.ts",
        "apps/web/**/*.tsx",
        "apps/internal/**/*.ts",
        "apps/internal/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": {
              "level": "warn",
              "options": {
                "reportUnnecessaryDependencies": false
              }
            },
            "useHookAtTopLevel": "error"
          },
          "nursery": {
            "useReactCompiler": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/**/*.ts",
        "apps/web/**/*.tsx",
        "apps/internal/**/*.ts",
        "apps/internal/**/*.tsx",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.cy.*",
        "!**/*.stories.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": {
              "level": "error",
              "options": {
                "allowConstantExport": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "src/core는 화면과 무관한 로직이라 React를 import하지 않는다. 화면 코드는 apps/web/src의 UI 폴더에 둔다.",
                  "react-dom": "src/core는 화면과 무관한 로직이라 React를 import하지 않는다. 화면 코드는 apps/web/src의 UI 폴더에 둔다.",
                  "@dfragon/ui": "src/core는 화면과 무관한 로직이라 @dfragon/ui를 import하지 않는다. 화면 코드는 apps/web/src의 UI 폴더에 둔다."
                },
                "patterns": [
                  {
                    "group": [
                      "**/hooks/**",
                      "**/components/**",
                      "**/pages/**",
                      "**/host/**",
                      "**/site/**",
                      "**/sections/**",
                      "**/animations/**",
                      "**/styles/**",
                      "**/fixture/**"
                    ],
                    "message": "src/core는 UI 폴더를 import하지 않는다. 화면 코드는 apps/web/src의 UI 폴더에 둔다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/**", "apps/web/src/hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**/pages",
                      "../**/pages/**",
                      "./**/pages",
                      "./**/pages/**",
                      "#pages",
                      "#pages/**",
                      "#*/**/pages",
                      "#*/**/pages/**"
                    ],
                    "message": "공용 components와 hooks는 pages/를 import하지 않는다. 화면 전용 코드는 pages/<화면>/에 두고, 여러 화면이 쓰는 코드는 공용 components/나 hooks/에 둔다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/host/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../**/pages",
                      "../**/pages/**",
                      "./**/pages",
                      "./**/pages/**",
                      "#pages",
                      "#pages/**",
                      "#*/**/pages",
                      "#*/**/pages/**",
                      "../**/components",
                      "../**/components/**",
                      "./**/components",
                      "./**/components/**",
                      "#components",
                      "#components/**",
                      "#*/**/components",
                      "#*/**/components/**",
                      "../**/hooks",
                      "../**/hooks/**",
                      "./**/hooks",
                      "./**/hooks/**",
                      "#hooks",
                      "#hooks/**",
                      "#*/**/hooks",
                      "#*/**/hooks/**"
                    ],
                    "message": "host는 pages/, components/, hooks/를 import하지 않는다. 화면 코드는 pages/에, 공용 UI는 components/나 hooks/에 두고 host를 가져다 쓴다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/**"],
      "linter": {
        "rules": {
          "style": {
            "useNodejsImportProtocol": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "useNodejsImportProtocol": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/application/**",
                      "**/infrastructure/**",
                      "**/presentation/**",
                      "**/runtime/**"
                    ],
                    "message": "domain은 다른 계층을 import하지 않는다. service와 port는 application/<기능>/, Neople과 DB 연결은 infrastructure/, controller는 presentation/에 두고, 그쪽에서 domain을 가져다 쓴다."
                  },
                  {
                    "group": ["@nestjs/**", "express"],
                    "message": "domain은 Nest, Express를 쓰지 않는다. controller와 decorator는 presentation/http/, module은 runtime/modules/에 둔다."
                  },
                  {
                    "group": ["node:*", "node:*/**"],
                    "message": "domain은 Node.js 내장 module을 쓰지 않는다. 파일, 네트워크, 프로세스를 쓰는 코드는 infrastructure/에 두고, application/<기능>/ports.ts의 함수 타입으로 받는다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/application/**"],
      "linter": {
        "rules": {
          "style": {
            "useNodejsImportProtocol": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/infrastructure/**", "**/presentation/**", "**/runtime/**"],
                    "message": "application은 infrastructure, presentation, runtime을 import하지 않는다. 외부 호출은 application/<기능>/ports.ts에 함수 타입으로 적고 구현은 infrastructure/에, 연결은 runtime/modules/에 둔다."
                  },
                  {
                    "group": ["@nestjs/**", "express"],
                    "message": "application은 Nest, Express를 쓰지 않는다. controller는 presentation/http/, provider 등록은 runtime/modules/에 둔다."
                  },
                  {
                    "group": [
                      "node:fs",
                      "node:fs/**",
                      "node:net",
                      "node:http",
                      "node:https",
                      "node:http2",
                      "node:tls",
                      "node:dgram",
                      "node:dns",
                      "node:dns/**",
                      "node:child_process",
                      "node:worker_threads",
                      "ky",
                      "koffi"
                    ],
                    "message": "application은 파일, 네트워크, native library를 직접 쓰지 않는다. application/<기능>/ports.ts에 함수 타입을 두고 구현은 infrastructure/에 둔다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/infrastructure/**"],
      "linter": {
        "rules": {
          "style": {
            "useNodejsImportProtocol": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/presentation/**", "**/runtime/**"],
                    "message": "infrastructure는 presentation, runtime을 import하지 않는다. HTTP 응답으로 바꾸는 코드는 presentation/http/, provider 등록은 runtime/modules/에 둔다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/presentation/**"],
      "linter": {
        "rules": {
          "style": {
            "useNodejsImportProtocol": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/infrastructure/**", "**/runtime/**"],
                    "message": "presentation은 infrastructure, runtime을 import하지 않는다. Neople과 DB 호출은 application의 service를 거치고, service와 adapter 연결은 runtime/modules/에 둔다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/runtime/api-app.ts", "apps/api/src/runtime/ops-app.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "./**",
                      "../**",
                      "!./modules/**",
                      "!./http-app.js",
                      "!./app-handle.js",
                      "!**/presentation/http/*.js"
                    ],
                    "message": "앱을 만드는 파일은 기능의 module(runtime/modules/<기능>.ts), 앱 공통 설정(runtime/), 여러 기능이 함께 쓰는 실패 표(presentation/http/ 바로 아래), access log만 import한다. 기능의 controller, service, reader, queue 연결은 runtime/modules/<기능>.ts에 두고 그 module을 import 목록에 더한다."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}

{
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Vite puts a content hash in every file name under /assets/. A 404 must not be cached for a year.
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}

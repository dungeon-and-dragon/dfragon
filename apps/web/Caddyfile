{
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Cross-origin isolation lets the OCR worker run ONNX Runtime WASM with threads. The worker script needs
	# the same headers, so they cover every path. credentialless keeps API and portrait responses loadable
	# without adding Cross-Origin-Resource-Policy to them.
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy credentialless
	}

	# Vite puts a content hash in every file name under /assets/. A 404 must not be cached for a year.
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# OCR file names carry no hash, so browsers check the ETag every time to pick up a new model.
	handle /ocr/* {
		header Cache-Control no-cache
		file_server
	}

	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}

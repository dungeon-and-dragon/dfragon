{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dfragon-web",
  "main": "worker/index.ts",
  // wrangler가 고정한 workerd가 지원하는 가장 늦은 날짜다.
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ocr/*", "/api/*"]
  },
  "workers_dev": false,
  "routes": [{ "pattern": "dfragon.com", "custom_domain": true }],
  "r2_buckets": [{ "binding": "OCR_ASSETS", "bucket_name": "dfragon-web-ocr" }],
  "env": {
    "dev": {
      "name": "dfragon-web-dev",
      // custom domain을 붙여도 workers.dev 주소를 남긴다. PR 미리보기 주소가 workers.dev 아래에 생긴다.
      "workers_dev": true,
      "preview_urls": true,
      "routes": [{ "pattern": "dev.dfragon.com", "custom_domain": true }],
      "r2_buckets": [{ "binding": "OCR_ASSETS", "bucket_name": "dfragon-web-ocr" }]
    }
  }
}

{
  "name": "@dfragon/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run prepare:ocr-assets && vite",
    "build": "pnpm run prepare:ocr-assets && tsc -b && vite build",
    "lint": "biome lint && pnpm run lint:imports",
    "lint:imports": "depcruise --config .dependency-cruiser.mjs --output-type err-long src",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "prepare:ocr-assets": "node scripts/prepare-ocr-assets.mjs public/ocr",
    "lint:fix": "biome lint --write",
    "format": "biome format --write && node ../../scripts/statement-spacing.mjs --write",
    "format:check": "biome format && node ../../scripts/statement-spacing.mjs --check",
    "test:nickname-evaluation": "tsc --noEmit -p scripts/nickname-evaluation/tsconfig.json && vitest run --config scripts/nickname-evaluation/vitest.config.ts",
    "test:portrait-evaluation": "tsc --noEmit -p scripts/portrait-evaluation/tsconfig.json && vitest run --config scripts/portrait-evaluation/vitest.config.ts",
    "test:raid-row-evaluation": "tsc --noEmit -p scripts/raid-row-evaluation/tsconfig.json && vitest run --config scripts/raid-row-evaluation/vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dfragon/lib": "workspace:*",
    "@dfragon/ui": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@xstate/react": "catalog:",
    "gsap": "catalog:",
    "ky": "catalog:",
    "onnxruntime-web": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "xstate": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@dfragon/licenses": "workspace:*",
    "@dfragon/models": "workspace:*",
    "@stylexjs/unplugin": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "pngjs": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "imports": {
    "#core/*.png": "./src/core/*.png",
    "#core/*": "./src/core/*.ts"
  }
}

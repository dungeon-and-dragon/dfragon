{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2024", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "paths": {
      "@dfragon/ui": ["../../packages/ui/src/index.tsx"],
      "@dfragon/lib": ["../../packages/lib/src/index.ts"],
      "@dfragon/lib/ocr-contract": ["../../packages/lib/src/ocr-contract.ts"],
      "@dfragon/lib/utils/shape-check": ["../../packages/lib/src/utils/shape-check.ts"],
      "@dfragon/desktop-shared/*": ["../desktop/src/shared/*"],
      "@dfragon/desktop-site/time-of-day": ["../desktop/src/frontend/src/site/time-of-day.ts"],
      "@dfragon/desktop-web": ["../desktop/src/frontend/src/site/web/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../desktop/src/preload/index.d.ts"]
}

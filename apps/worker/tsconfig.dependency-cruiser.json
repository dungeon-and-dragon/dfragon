{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "#domain/*": ["./src/domain/*"],
      "#application/*": ["./src/application/*"],
      "#infrastructure/*": ["./src/infrastructure/*"],
      "#runtime/*": ["./src/runtime/*"],
      "@dfragon/database": ["../../packages/database/src/index.ts"],
      "@dfragon/neople": ["../../packages/neople/src/index.ts"],
      "@dfragon/server-core/*": ["../../packages/server-core/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}

PORT=3443
# Set exactly one of NEOPLE_API_KEY or NEOPLE_API_KEY_FILE. File paths must be absolute.
NEOPLE_API_KEY=<neople-api-key>
# NEOPLE_API_KEY_FILE=/absolute/path/outside-repository/neople-api-key
API_ORIGIN=https://localhost:3443
LOCAL_HTTPS_CERT_FILE=/absolute/path/outside-repository/localhost.pem
LOCAL_HTTPS_KEY_FILE=/absolute/path/outside-repository/localhost-key.pem
# Comma-separated loopback origins of the local web dev server allowed by CORS.
# WEB_DEV_ORIGINS=http://localhost:5173

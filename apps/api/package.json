{
  "name": "@dfragon/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.11.1 <27"
  },
  "scripts": {
    "dev": "pnpm run build && dotenv --no-expand -- pnpm run start",
    "build": "pnpm --filter @dfragon/lib --filter @dfragon/database --filter @dfragon/neople build && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "pnpm run build && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('.test-dist', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node --test \".test-dist/test/**/*.test.js\" test-support/*.test.mjs",
    "verify:skills": "pnpm run build && node test-support/verify-skill-calculation.mjs",
    "typecheck": "pnpm --filter @dfragon/lib --filter @dfragon/database --filter @dfragon/neople build && tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/main.js",
    "lint": "biome lint && pnpm run lint:imports",
    "lint:imports": "depcruise --config .dependency-cruiser.mjs --output-type err-long src",
    "lint:fix": "biome lint --write",
    "format": "biome format --write && node ../../scripts/statement-spacing.mjs --write",
    "format:check": "biome format && node ../../scripts/statement-spacing.mjs --check"
  },
  "dependencies": {
    "@date-fns/tz": "catalog:",
    "@dfragon/database": "workspace:*",
    "@dfragon/lib": "workspace:*",
    "@dfragon/neople": "workspace:*",
    "@hono/node-server": "catalog:",
    "croner": "catalog:",
    "dataloader": "catalog:",
    "date-fns": "catalog:",
    "hono": "catalog:",
    "koffi": "catalog:",
    "ky": "catalog:",
    "lru-cache": "catalog:",
    "p-throttle": "catalog:",
    "remeda": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "typescript": "catalog:"
  }
}

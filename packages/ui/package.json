{
  "name": "@dfragon/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "pnpm typecheck && vitest run && pnpm test:tooling",
    "test:tooling": "node --test test/build-verification.node.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "build": "vite build && tsc -p tsconfig.build.json && pnpm verify:build",
    "verify:build": "node scripts/verify-build.mjs library dist && tsc -p test/build-consumer/tsconfig.json && vite build --config test/build-consumer/vite.config.ts && node --test test/build-exports.node.mjs",
    "lint:fix": "biome lint --write",
    "format": "biome format --write && node ../../scripts/statement-spacing.mjs --write",
    "format:check": "biome format && node ../../scripts/statement-spacing.mjs --check"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "typescript-compiler-api": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "@dfragon/licenses": "workspace:*",
    "@dfragon/design": "workspace:*",
    "@storybook/react-vite": "catalog:"
  },
  "files": [
    "dist",
    "README.md"
  ]
}

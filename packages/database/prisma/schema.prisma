generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Season {
  id       Int      @id
  name     String
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)

  @@map("seasons")
}

model Adventure {
  id         BigInt      @id @default(autoincrement())
  name       String
  characters Character[]

  @@index([name])
  @@map("adventures")
}

model Character {
  serverId       String    @map("server_id")
  characterId    String    @map("character_id")
  characterName  String    @map("character_name")
  adventureId    BigInt    @map("adventure_id")
  adventure      Adventure @relation(fields: [adventureId], references: [id])
  level          Int?
  jobId          String?   @map("job_id")
  jobGrowId      String?   @map("job_grow_id")
  jobName        String?   @map("job_name")
  jobGrowName    String?   @map("job_grow_name")
  fame           Int?
  maxFame        Int?      @map("max_fame")
  guildId        String?   @map("guild_id")
  guildName      String?   @map("guild_name")
  basicFetchedAt DateTime? @map("basic_fetched_at") @db.Timestamptz(3)
  skillStyle     CharacterSkillStyle?

  @@id([serverId, characterId])
  @@index([adventureId])
  @@index([serverId, characterName])
  @@index([guildId])
  @@index([fame(sort: Desc)])
  @@index([maxFame(sort: Desc)])
  @@index([jobId, fame(sort: Desc)])
  @@index([jobId, jobGrowId, fame(sort: Desc)])
  @@map("characters")
}

model CharacterSkillStyle {
  serverId     String    @map("server_id")
  characterId  String    @map("character_id")
  character    Character @relation(fields: [serverId, characterId], references: [serverId, characterId], onDelete: Cascade)
  jobId        String    @map("job_id")
  jobGrowId    String    @map("job_grow_id")
  skills       Json
  evolutions   Json
  enhancements Json
  fetchedAt    DateTime  @map("fetched_at") @db.Timestamptz(3)

  @@id([serverId, characterId])
  @@map("character_skill_styles")
}

model CharacterCollection {
  serverId    String    @map("server_id")
  characterId String    @map("character_id")
  queuedAt    DateTime  @default(now()) @map("queued_at") @db.Timestamptz(3)
  attemptedAt DateTime? @map("attempted_at") @db.Timestamptz(3)
  failure     String?

  @@id([serverId, characterId])
  @@index([queuedAt])
  @@map("character_collection")
}

model TimelineEvent {
  id          BigInt   @id @default(autoincrement())
  serverId    String   @map("server_id")
  characterId String   @map("character_id")
  code        Int
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  name        String
  raidName    String?  @map("raid_name")
  data        Json

  @@index([serverId, characterId, code, occurredAt])
  @@map("timeline_events")
}

model TimelineItem {
  id          BigInt   @default(autoincrement())
  serverId    String   @map("server_id")
  characterId String   @map("character_id")
  code        Int
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  name        String
  itemId      String?  @map("item_id")
  itemName    String?  @map("item_name")
  itemRarity  String?  @map("item_rarity")
  data        Json

  @@id([id, occurredAt])
  @@index([serverId, characterId, code, occurredAt])
  @@map("timeline_items")
}

model TimelineSyncState {
  serverId        String    @map("server_id")
  characterId     String    @map("character_id")
  syncedUntil     DateTime? @map("synced_until") @db.Timestamptz(3)
  lastAttemptedAt DateTime? @map("last_attempted_at") @db.Timestamptz(3)
  lastSucceededAt DateTime? @map("last_succeeded_at") @db.Timestamptz(3)
  lastFailure     String?   @map("last_failure")
  enhancementBackfilledUntil DateTime? @map("enhancement_backfilled_until") @db.Timestamptz(3)

  @@id([serverId, characterId])
  @@map("timeline_sync_state")
}

model TimelineSeasonBackfill {
  serverId        String    @map("server_id")
  characterId     String    @map("character_id")
  seasonId        Int       @map("season_id")
  backfilledUntil DateTime  @map("backfilled_until") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)

  @@id([serverId, characterId, seasonId])
  @@map("timeline_season_backfill")
}

model ContentClear {
  contentId   String   @map("content_id")
  kind        String
  serverId    String   @map("server_id")
  characterId String   @map("character_id")
  weekStart   DateTime @map("week_start") @db.Timestamptz(3)
  clearedAt   DateTime @map("cleared_at") @db.Timestamptz(3)
  ratio       Int?

  @@id([contentId, serverId, characterId, weekStart])
  @@index([contentId, weekStart])
  @@map("content_clears")
}

model ContentClearPopulation {
  contentId   String   @map("content_id")
  weekStart   DateTime @map("week_start") @db.Timestamptz(3)
  population  Int
  minFame     Int?     @map("min_fame")
  jobs        Json
  collectedAt DateTime @map("collected_at") @db.Timestamptz(3)
  closed      Boolean  @default(false)

  @@id([contentId, weekStart])
  @@map("content_clear_populations")
}

model ContentClearCollection {
  startedAt DateTime @id @map("started_at") @db.Timestamptz(3)
  done      Int      @default(0)

  @@map("content_clear_collections")
}

model Job {
  name          String    @id
  displayName   String    @map("display_name")
  description   String    @default("")
  schedule      String?
  argsSchema    Json      @map("args_schema")
  delayMinutes  Int       @map("delay_minutes")
  pausedAt      DateTime? @map("paused_at") @db.Timestamptz(3)
  nextRunAt     DateTime? @map("next_run_at") @db.Timestamptz(3)
  workerSeenAt  DateTime  @map("worker_seen_at") @db.Timestamptz(3)

  @@map("jobs")
}

model JobRun {
  id            Int       @id @default(autoincrement())
  jobName       String    @map("job_name")
  trigger       String
  status        String
  args          Json
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  startedAt     DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)
  progressDone  Int?      @map("progress_done")
  progressTotal Int?      @map("progress_total")
  summary       Json?
  error         Json?

  @@index([jobName, requestedAt(sort: Desc)])
  @@map("job_runs")
}

model CharacterStatsSnapshot {
  id               Int      @id @default(1)
  computedAt       DateTime @map("computed_at") @db.Timestamptz(3)
  total            Int
  servers          Json
  jobs             Json
  fameDistribution Json     @map("fame_distribution")

  @@map("character_stats")
}

model JobSkillAdoptionSnapshot {
  jobId        String   @map("job_id")
  jobGrowId    String   @map("job_grow_id")
  role         String
  computedAt   DateTime @map("computed_at") @db.Timestamptz(3)
  minFame      Int?     @map("min_fame")
  sampleSize   Int      @map("sample_size")
  skills       Json
  evolutions   Json
  enhancements Json

  @@id([jobId, jobGrowId, role])
  @@map("job_skill_adoption")
}

model BatchNeopleKey {
  id         Int       @id @default(autoincrement())
  label      String
  key        String    @unique
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  rejectedAt DateTime? @map("rejected_at") @db.Timestamptz(3)

  @@map("batch_neople_keys")
}

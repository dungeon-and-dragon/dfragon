generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Season {
  id       Int      @id
  name     String
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)

  @@map("seasons")
}

model Adventure {
  id         BigInt      @id @default(autoincrement())
  name       String
  characters Character[]

  @@index([name])
  @@map("adventures")
}

model Character {
  serverId       String    @map("server_id")
  characterId    String    @map("character_id")
  characterName  String    @map("character_name")
  adventureId    BigInt    @map("adventure_id")
  adventure      Adventure @relation(fields: [adventureId], references: [id])
  level          Int?
  jobId          String?   @map("job_id")
  jobGrowId      String?   @map("job_grow_id")
  jobName        String?   @map("job_name")
  jobGrowName    String?   @map("job_grow_name")
  fame           Int?
  maxFame        Int?      @map("max_fame")
  guildId        String?   @map("guild_id")
  guildName      String?   @map("guild_name")
  basicFetchedAt DateTime? @map("basic_fetched_at") @db.Timestamptz(3)
  lastActiveAt   DateTime? @map("last_active_at") @db.Timestamptz(3)
  inactiveSince  DateTime? @map("inactive_since") @db.Timestamptz(3)
  equipmentSetId   String?   @map("equipment_set_id")
  equipmentSetName String?   @map("equipment_set_name")
  oathSetId        Int?      @map("oath_set_id")
  oathSetName      String?   @map("oath_set_name")
  oathSetOption    String?   @map("oath_set_option")
  setsFetchedAt    DateTime? @map("sets_fetched_at") @db.Timestamptz(3)
  skillStyle     CharacterSkillStyle?
  items          CharacterItem[]
  score          CharacterScore?
  basicHistory   CharacterBasicHistory[]
  sectionHistory CharacterSectionHistory[]
  scoreHistory   CharacterScoreHistory[]

  @@id([serverId, characterId])
  @@index([adventureId])
  @@index([serverId, characterName])
  @@index([guildId])
  @@index([fame(sort: Desc)])
  @@index([maxFame(sort: Desc)])
  @@index([jobId, fame(sort: Desc)])
  @@index([jobId, jobGrowId, fame(sort: Desc)])
  @@map("characters")
}

model CharacterItem {
  serverId    String    @map("server_id")
  characterId String    @map("character_id")
  character   Character @relation(fields: [serverId, characterId], references: [serverId, characterId], onDelete: Cascade)
  slotId      String    @map("slot_id")
  itemId      String    @map("item_id")
  itemName    String    @map("item_name")
  typeDetail  String?   @map("item_type_detail")

  @@id([serverId, characterId, slotId])
  @@index([itemId])
  @@map("character_items")
}

model CharacterSkillStyle {
  serverId     String    @map("server_id")
  characterId  String    @map("character_id")
  character    Character @relation(fields: [serverId, characterId], references: [serverId, characterId], onDelete: Cascade)
  jobId        String    @map("job_id")
  jobGrowId    String    @map("job_grow_id")
  skills       Json
  evolutions   Json
  enhancements Json
  chain        Json?
  fetchedAt    DateTime  @map("fetched_at") @db.Timestamptz(3)

  @@id([serverId, characterId])
  @@map("character_skill_styles")
}

model CharacterScore {
  serverId       String    @map("server_id")
  characterId    String    @map("character_id")
  character      Character @relation(fields: [serverId, characterId], references: [serverId, characterId], onDelete: Cascade)
  kind           String
  score          Int
  calculatedAt   DateTime  @map("calculated_at") @db.Timestamptz(3)
  enginePackage  String    @map("engine_package")
  engineRulesRev String    @map("engine_rules_rev")
  engineBundleId String    @map("engine_bundle_id")
  jobId          String?   @map("job_id")
  jobGrowId      String?   @map("job_grow_id")
  approximateSource String? @map("approximate_source")

  @@id([serverId, characterId])
  @@index([kind, jobId, jobGrowId, score(sort: Desc), serverId, characterId], map: "character_scores_kind_job_score_idx")
  @@map("character_scores")
}

model CharacterBasicHistory {
  serverId      String    @map("server_id")
  characterId   String    @map("character_id")
  character     Character @relation(fields: [serverId, characterId], references: [serverId, characterId], onDelete: Cascade)
  observedAt    DateTime  @map("observed_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @map("last_seen_at") @db.Timestamptz(3)
  characterName String    @map("character_name")
  adventureName String    @map("adventure_name")
  level         Int
  jobId         String    @map("job_id")
  jobGrowId     String    @map("job_grow_id")
  jobName       String    @map("job_name")
  jobGrowName   String    @map("job_grow_name")
  fame          Int?
  guildId       String?   @map("guild_id")
  guildName     String?   @map("guild_name")

  @@id([serverId, characterId, observedAt])
  @@map("character_basic_history")
}

model CharacterSectionHistory {
  serverId    String    @map("server_id")
  characterId String    @map("character_id")
  character   Character @relation(fields: [serverId, characterId], references: [serverId, characterId], onDelete: Cascade)
  section     String
  observedAt  DateTime  @map("observed_at") @db.Timestamptz(3)
  contentHash String    @map("content_hash") @db.Uuid
  data        Json

  @@id([serverId, characterId, section, observedAt])
  @@map("character_section_history")
}

model CharacterScoreHistory {
  serverId    String      @map("server_id")
  characterId String      @map("character_id")
  character   Character   @relation(fields: [serverId, characterId], references: [serverId, characterId], onDelete: Cascade)
  observedAt  DateTime    @map("observed_at") @db.Timestamptz(3)
  kind        String
  score       Int
  engineId    Int         @map("engine_id")
  engine      ScoreEngine @relation(fields: [engineId], references: [id])
  approximateSource  String? @map("approximate_source")
  approximateWarning String? @map("approximate_warning")
  skippedKind        String? @map("skipped_kind")
  skippedMessage     String? @map("skipped_message")

  @@id([serverId, characterId, observedAt])
  @@map("character_score_history")
}

model ScoreEngine {
  id           Int                     @id @default(autoincrement())
  package      String
  rulesRev     String                  @map("rules_rev")
  bundleId     String                  @map("bundle_id")
  scoreHistory CharacterScoreHistory[]

  @@unique([package, rulesRev, bundleId])
  @@map("score_engines")
}

model CharacterCollection {
  serverId    String    @map("server_id")
  characterId String    @map("character_id")
  queuedAt    DateTime  @default(now()) @map("queued_at") @db.Timestamptz(3)
  attemptedAt DateTime? @map("attempted_at") @db.Timestamptz(3)
  failure     String?

  @@id([serverId, characterId])
  @@index([queuedAt])
  @@map("character_collection")
}

model TimelineEvent {
  id          BigInt   @id @default(autoincrement())
  serverId    String   @map("server_id")
  characterId String   @map("character_id")
  code        Int
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  name        String
  raidName    String?  @map("raid_name")
  data        Json

  @@index([serverId, characterId, code, occurredAt])
  @@map("timeline_events")
}

model TimelineItem {
  id          BigInt   @default(autoincrement())
  serverId    String   @map("server_id")
  characterId String   @map("character_id")
  code        Int
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  name        String
  itemId      String?  @map("item_id")
  itemName    String?  @map("item_name")
  itemRarity  String?  @map("item_rarity")
  data        Json

  @@id([id, occurredAt])
  @@index([serverId, characterId, code, occurredAt])
  @@map("timeline_items")
}

model TimelineSyncState {
  serverId        String    @map("server_id")
  characterId     String    @map("character_id")
  syncedUntil     DateTime? @map("synced_until") @db.Timestamptz(3)
  lastAttemptedAt DateTime? @map("last_attempted_at") @db.Timestamptz(3)
  lastSucceededAt DateTime? @map("last_succeeded_at") @db.Timestamptz(3)
  lastFailure     String?   @map("last_failure")
  enhancementBackfilledUntil DateTime? @map("enhancement_backfilled_until") @db.Timestamptz(3)

  @@id([serverId, characterId])
  @@map("timeline_sync_state")
}

model TimelineSyncRequest {
  kind        String
  serverId    String    @map("server_id")
  characterId String    @map("character_id")
  seasonId    Int       @default(0) @map("season_id")
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  awaitedAt   DateTime? @map("awaited_at") @db.Timestamptz(3)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)

  @@id([kind, serverId, characterId, seasonId])
  @@map("timeline_sync_requests")
}

model TimelineSeasonBackfill {
  serverId        String    @map("server_id")
  characterId     String    @map("character_id")
  seasonId        Int       @map("season_id")
  backfilledUntil DateTime  @map("backfilled_until") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)

  @@id([serverId, characterId, seasonId])
  @@map("timeline_season_backfill")
}

model ContentClear {
  contentId           String   @map("content_id")
  kind                String
  serverId            String   @map("server_id")
  characterId         String   @map("character_id")
  weekStart           DateTime @map("week_start") @db.Timestamptz(3)
  clearedAt           DateTime @map("cleared_at") @db.Timestamptz(3)
  ratio               Int?
  maxFame             Int?     @map("max_fame")
  score               Int?
  scoreKind           String?  @map("score_kind")
  scoreEnginePackage  String?  @map("score_engine_package")
  scoreEngineRulesRev String?  @map("score_engine_rules_rev")
  scoreEngineBundleId String?  @map("score_engine_bundle_id")

  @@id([contentId, serverId, characterId, weekStart])
  @@index([contentId, weekStart])
  @@map("content_clears")
}

model ContentClearPopulation {
  contentId   String   @map("content_id")
  weekStart   DateTime @map("week_start") @db.Timestamptz(3)
  population  Int
  minFame     Int?     @map("min_fame")
  jobs        Json
  collectedAt DateTime @map("collected_at") @db.Timestamptz(3)
  closed      Boolean  @default(false)

  @@id([contentId, weekStart])
  @@map("content_clear_populations")
}

model ContentClearWeekSample {
  contentId  String   @map("content_id")
  weekStart  DateTime @map("week_start") @db.Timestamptz(3)
  samples    Json
  computedAt DateTime @map("computed_at") @db.Timestamptz(3)

  @@id([contentId, weekStart])
  @@map("content_clear_week_samples")
}

model ContentClearOverviewSample {
  weekStart  DateTime @id @map("week_start") @db.Timestamptz(3)
  samples    Json
  computedAt DateTime @map("computed_at") @db.Timestamptz(3)

  @@map("content_clear_overview_samples")
}

model ContentClearCollection {
  startedAt DateTime @id @map("started_at") @db.Timestamptz(3)
  done      Int      @default(0)

  @@map("content_clear_collections")
}

model ClearRecord {
  serverId    String   @map("server_id")
  characterId String   @map("character_id")
  kind        String
  name        String
  modeName    String?  @map("mode_name")
  hard        Boolean?
  partyName   String?  @map("party_name")
  clearedAt   DateTime @map("cleared_at") @db.Timestamptz(3)
  weekStart   DateTime @map("week_start") @db.Timestamptz(3)

  @@id([serverId, characterId, clearedAt, kind, name])
  @@index([kind, name, weekStart])
  @@map("clear_records")
}

model ClearRecordBackfill {
  startedAt DateTime @id @map("started_at") @db.Timestamptz(3)
  done      Int      @default(0)

  @@map("clear_record_backfills")
}

model ClearRecordCursor {
  serverId     String   @map("server_id")
  characterId  String   @map("character_id")
  fetchedUntil DateTime @map("fetched_until") @db.Timestamptz(3)

  @@id([serverId, characterId])
  @@map("clear_record_cursors")
}

model Job {
  name            String    @id
  displayName     String    @map("display_name")
  description     String    @default("")
  schedule        String?
  argsSchema      Json      @map("args_schema")
  delayMinutes    Int       @map("delay_minutes")
  neopleApiGroup  String?   @map("neople_api_group")
  neopleEndpoints String[]  @default([]) @map("neople_endpoints")
  pausedAt        DateTime? @map("paused_at") @db.Timestamptz(3)
  nextRunAt       DateTime? @map("next_run_at") @db.Timestamptz(3)
  workerSeenAt    DateTime  @map("worker_seen_at") @db.Timestamptz(3)

  @@map("jobs")
}

model JobRun {
  id            Int       @id @default(autoincrement())
  jobName       String    @map("job_name")
  trigger       String
  status        String
  args          Json
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  startedAt     DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)
  progressDone  Int?      @map("progress_done")
  progressTotal Int?      @map("progress_total")
  summary       Json?
  error         Json?

  @@index([jobName, requestedAt(sort: Desc)])
  @@map("job_runs")
}

model CharacterStatsSnapshot {
  id               Int      @id @default(1)
  computedAt       DateTime @map("computed_at") @db.Timestamptz(3)
  total            Int
  servers          Json
  jobs             Json
  fameDistribution Json     @map("fame_distribution")

  @@map("character_stats")
}

model JobSkillAdoptionSnapshot {
  jobId           String   @map("job_id")
  jobGrowId       String   @map("job_grow_id")
  role            String
  computedAt      DateTime @map("computed_at") @db.Timestamptz(3)
  minFame         Int?     @map("min_fame")
  sampleSize      Int      @map("sample_size")
  skills          Json
  evolutions      Json
  enhancements    Json
  chains          Json     @default("[]")
  chainSampleSize Int      @default(0) @map("chain_sample_size")

  @@id([jobId, jobGrowId, role])
  @@map("job_skill_adoption")
}

model ItemAdoption {
  id         BigInt   @id @default(autoincrement())
  jobId      String   @map("job_id")
  jobGrowId  String   @map("job_grow_id")
  role       String
  slotId     String?  @map("slot_id")
  itemId     String?  @map("item_id")
  itemName   String?  @map("item_name")
  typeDetail String?  @map("item_type_detail")
  sample     String   @default("all")
  count      Int
  computedAt DateTime @map("computed_at") @db.Timestamptz(3)

  @@index([sample, jobId, jobGrowId, role])
  @@map("item_adoption")
}

model SetAdoption {
  id               BigInt   @id @default(autoincrement())
  jobId            String   @map("job_id")
  jobGrowId        String   @map("job_grow_id")
  role             String
  equipmentSetId   String?  @map("equipment_set_id")
  equipmentSetName String?  @map("equipment_set_name")
  oathSetId        Int?     @map("oath_set_id")
  oathSetName      String?  @map("oath_set_name")
  oathSetOption    String?  @map("oath_set_option")
  sample           String   @default("all")
  count            Int
  computedAt       DateTime @map("computed_at") @db.Timestamptz(3)

  @@index([sample, jobId, jobGrowId, role])
  @@map("set_adoption")
}

model BatchNeopleKey {
  id         Int       @id @default(autoincrement())
  label      String
  key        String    @unique
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  rejectedAt DateTime? @map("rejected_at") @db.Timestamptz(3)

  @@map("batch_neople_keys")
}

model WorkerEvent {
  id         BigInt   @id @default(autoincrement())
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  code       String
  details    Json

  @@index([occurredAt])
  @@index([code, occurredAt(sort: Desc)])
  @@map("worker_events")
}

model Item {
  itemId         String   @id @map("item_id")
  availableLevel Int?     @map("available_level")
  itemType       String?  @map("item_type")
  itemTypeDetail String?  @map("item_type_detail")
  itemRarity     String?  @map("item_rarity")
  setItemId      String?  @map("set_item_id")
  setItemName    String?  @map("set_item_name")
  fetchedAt      DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@map("items")
}

model LabItem {
  id            BigInt       @id @default(autoincrement())
  category      String
  role          String
  tier          String
  itemName      String       @map("item_name")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  currencyId    BigInt?      @map("currency_id")
  currencyCount Int?         @map("currency_count")
  currency      LabCurrency? @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([category, role, tier, itemName])
  @@index([currencyId])
  @@map("lab_items")
}

model LabCurrency {
  id              BigInt    @id @default(autoincrement())
  name            String    @unique
  icon            Bytes
  iconContentType String    @map("icon_content_type")
  description     String?
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  items           LabItem[]

  @@map("lab_currencies")
}

model LabItemDetail {
  itemName        String   @id @map("item_name")
  icon            Bytes?
  iconContentType String?  @map("icon_content_type")
  description     String?
  itemRarity      String?  @map("item_rarity")
  itemTypeDetail  String?  @map("item_type_detail")
  availableLevel  Int?     @map("available_level")
  fame            Int?
  card            Json?
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("lab_item_details")
}

model AuctionPrice {
  itemName   String   @id @map("item_name")
  itemId     String?  @map("item_id")
  itemRarity String?  @map("item_rarity")
  unitPrice  BigInt?  @map("unit_price")
  checkedAt  DateTime @map("checked_at") @db.Timestamptz(3)

  @@map("auction_prices")
}

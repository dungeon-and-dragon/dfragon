{
  "name": "@dfragon/neople",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter @dfragon/lib build && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "lint": "biome lint",
    "format:check": "biome format && node ../../scripts/statement-spacing.mjs --check"
  },
  "dependencies": {
    "@dfragon/lib": "workspace:*",
    "ky": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}

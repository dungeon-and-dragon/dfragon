{
  "name": "@dfragon/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./web": "./src/site/web/index.ts",
    "./time-of-day": "./src/site/time-of-day.ts",
    "./globals": {
      "types": "./src/globals.d.ts"
    }
  },
  "scripts": {
    "test": "pnpm typecheck && vitest run",
    "typecheck": "tsc --noEmit",
    "test:portrait-evaluation": "tsc --noEmit -p scripts/portrait-evaluation/tsconfig.json && vitest run --config scripts/portrait-evaluation/vitest.config.ts",
    "test:raid-row-evaluation": "tsc --noEmit -p scripts/raid-row-evaluation/tsconfig.json && vitest run --config scripts/raid-row-evaluation/vitest.config.ts",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write && node ../../scripts/statement-spacing.mjs --write",
    "format:check": "biome format && node ../../scripts/statement-spacing.mjs --check"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "dependencies": {
    "@dfragon/client-core": "workspace:*",
    "@dfragon/lib": "workspace:*",
    "@dfragon/ui": "workspace:*",
    "@xstate/react": "catalog:",
    "ky": "catalog:",
    "onnxruntime-web": "catalog:",
    "xstate": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@dfragon/models": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "@stylexjs/unplugin": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "pngjs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

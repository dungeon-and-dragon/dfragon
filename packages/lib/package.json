{
  "name": "@dfragon/lib",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./avatar-presets": {
      "types": "./dist/avatar-presets.d.ts",
      "import": "./dist/avatar-presets.js"
    },
    "./buff-switching": {
      "types": "./dist/buff-switching.d.ts",
      "import": "./dist/buff-switching.js"
    },
    "./content-clear-catalog": {
      "types": "./dist/content-clear-catalog.d.ts",
      "import": "./dist/content-clear-catalog.js"
    },
    "./equipment-variants": {
      "types": "./dist/equipment-variants.d.ts",
      "import": "./dist/equipment-variants.js"
    },
    "./epic-soul-recovery": {
      "types": "./dist/epic-soul-recovery.d.ts",
      "import": "./dist/epic-soul-recovery.js"
    },
    "./error-chain": {
      "types": "./dist/error-chain.d.ts",
      "import": "./dist/error-chain.js"
    },
    "./enchant-grades": {
      "types": "./dist/enchant-grades.d.ts",
      "import": "./dist/enchant-grades.js"
    },
    "./enchant-options": {
      "types": "./dist/enchant-options.d.ts",
      "import": "./dist/enchant-options.js"
    },
    "./lab-items": {
      "types": "./dist/lab-items.d.ts",
      "import": "./dist/lab-items.js"
    },
    "./port": {
      "types": "./dist/port.d.ts",
      "import": "./dist/port.js"
    },
    "./slot-items": {
      "types": "./dist/slot-items.d.ts",
      "import": "./dist/slot-items.js"
    },
    "./utils/assert": {
      "types": "./dist/utils/assert.d.ts",
      "import": "./dist/utils/assert.js"
    },
    "./utils/shape-check": {
      "types": "./dist/utils/shape-check.d.ts",
      "import": "./dist/utils/shape-check.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSES",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && dfragon-copy-notices lib dist/notices && dfragon-copy-notices lib LICENSES",
    "test": "pnpm build && node --test test/*.test.mjs",
    "generate:cp949": "node scripts/generate-cp949.mjs",
    "generate:avatar-presets": "node scripts/generate-avatar-presets.mjs && biome format --write src/avatar-presets.json",
    "generate:equipment-variants": "node scripts/generate-equipment-variants.mjs && biome format --write src/equipment-variants.json",
    "lint": "biome lint",
    "format:check": "biome format && node ../../scripts/statement-spacing.mjs --check"
  },
  "devDependencies": {
    "iconv-lite": "catalog:",
    "typescript": "catalog:",
    "typescript-compiler-api": "catalog:",
    "@dfragon/licenses": "workspace:*"
  }
}

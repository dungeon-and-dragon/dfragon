{
  "name": "@dfragon/client-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.png": "./src/*.png",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "pnpm typecheck && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write && node ../../scripts/statement-spacing.mjs --write",
    "format:check": "biome format && node ../../scripts/statement-spacing.mjs --check"
  },
  "dependencies": {
    "@dfragon/lib": "workspace:*",
    "ky": "catalog:",
    "xstate": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "pngjs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
